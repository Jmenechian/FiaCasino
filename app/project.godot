config_version=5

[application]
config/name="FiaCasino"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=700
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="FiaCasino"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.065, 0.06, 1)
